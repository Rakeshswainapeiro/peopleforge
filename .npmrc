engine-strict=true
save-exact=true
auto-install-peers=true
strict-peer-dependencies=false

# Shared @sirius/* packages (js-platform) come from the private registry only.
# Local: Verdaccio in ~/sirius/local-infra. Replace with the approved registry later (ADR-001).
# Credentials live in your user-level ~/.npmrc (npm adduser), never in this file.
@sirius:registry=http://localhost:4873/
