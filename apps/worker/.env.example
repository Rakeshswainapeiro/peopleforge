# Copy to apps/worker/.env for local development. Never commit real values.
# Full reference (purpose, required/optional, secret store): DEPLOYMENT.md §4.

APP_ENV=dev
LOG_LEVEL=debug
HEALTH_PORT=4200

# PostgreSQL from local-infra, as the WORKER role (email outbox only; ADR-012). Create the role
# once: README "Email locally".
WORKER_DATABASE_URL=postgres://peopleforge_worker:local-pf-worker-2026@localhost:55432/peopleforge
DATABASE_POOL_MAX=4

# Links in emails point here.
PORTAL_URL=http://localhost:3000

# Mailpit (infra/local/compose.yaml) catches every email: http://localhost:8025
EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply@peopleforge.local
EMAIL_FROM_NAME=PeopleForge
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_TIMEOUT_MS=10000
# Or write .eml files instead (no Docker needed):
# EMAIL_TRANSPORT=file
# EMAIL_FILE_DIR=/tmp/peopleforge-mail

OUTBOX_POLL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_LEASE_MS=300000
OUTBOX_STATS_INTERVAL_MS=60000
OUTBOX_ALERT_AFTER_S=900
SHUTDOWN_TIMEOUT_MS=25000
