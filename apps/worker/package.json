{
  "name": "@peopleforge/worker",
  "version": "0.1.0",
  "private": true,
  "description": "PeopleForge background worker: sends the notification email outbox (R1-07, R1-13; ADR-012). Scheduled jobs join later (S7).",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@peopleforge/db": "workspace:*",
    "@peopleforge/i18n": "workspace:*",
    "@peopleforge/integrations": "workspace:*",
    "@sirius/shared-types": "0.1.0",
    "@sirius/utils": "0.1.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sirius/config": "0.1.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
