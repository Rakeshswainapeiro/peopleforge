# Copy to apps/api/.env for local development. Never commit real values.
# Full reference (purpose, required/optional, secret store): DEPLOYMENT.md §4.

APP_ENV=dev
PORT=4000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT_KB=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
READINESS_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=25000

# Identity provider. Locally: the Keycloak realm from ~/sirius/local-infra, shaped like Entra ID
# (same oid/tid/roles claims). Production: Entra ID (A6). No secret needed: the API only checks
# signatures against the provider's published keys.
OIDC_ISSUER=http://keycloak.sirius.test:8180/realms/sirius
OIDC_AUDIENCE=peopleforge-api
OIDC_TENANT_ID=5a1f0c2e-7b3d-4e8a-9c21-5e7f0000c0de
OIDC_ALLOW_HTTP=true
OIDC_TIMEOUT_MS=5000

# PostgreSQL from local-infra, as the app role (data access only; RLS applies). ADR-002.
DATABASE_URL=postgres://peopleforge_app:local-pf-app-2026@localhost:55432/peopleforge
DATABASE_POOL_MAX=10

# Salary field encryption (ADR-008). Use the SAME values as packages/db/.env: the seed encrypts
# employee salaries with them and the API must decrypt them.
DATA_ENCRYPTION_KEYS=local-1:replace-with-the-value-from-packages-db-env
DATA_ENCRYPTION_ACTIVE_KEY=local-1

# Evidence files (R1-04, ADR-010). Quick start: files on local disk and no malware scan
# (both refused in UAT/production). To exercise the real path locally, run S3Mock and ClamAV
# (README, "Evidence files locally") and use the commented values instead.
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_DIR=/tmp/peopleforge-evidence
MALWARE_SCANNER=none
# OBJECT_STORE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9090
# S3_REGION=me-central-1
# S3_BUCKET=peopleforge-evidence
# S3_ACCESS_KEY_ID=local
# S3_SECRET_ACCESS_KEY=local-only-not-a-secret
# S3_FORCE_PATH_STYLE=true
# MALWARE_SCANNER=clamav
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
