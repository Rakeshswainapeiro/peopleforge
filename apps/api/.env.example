# Copy to apps/api/.env for local development. Never commit real values.
# Full reference (purpose, required/optional, secret store): DEPLOYMENT.md §4.

APP_ENV=dev
PORT=4000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT_KB=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
READINESS_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=25000
