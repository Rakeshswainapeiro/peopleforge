{
  "name": "@peopleforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env.local scripts/migrate.ts down",
    "db:status": "node --env-file-if-exists=.env.local scripts/migrate.ts status"
  },
  "dependencies": {
    "@peopleforge/contracts": "workspace:*",
    "@peopleforge/db": "workspace:*",
    "@peopleforge/i18n": "workspace:*",
    "@peopleforge/ui": "workspace:*",
    "@sirius/auth-better": "0.1.0",
    "@sirius/login-ui": "0.1.3",
    "@sirius/shared-types": "0.1.0",
    "@sirius/utils": "0.1.0",
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.8",
    "@peopleforge/integrations": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sirius/config": "0.1.0",
    "@sirius/identity": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
