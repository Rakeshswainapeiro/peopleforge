# Copy to apps/web/.env.local for local development. Never commit real values.
# Full reference: DEPLOYMENT.md §4.

# Next.js telemetry sends usage data to Vercel (outside the approved region). Keep disabled.
NEXT_TELEMETRY_DISABLED=1

APP_ENV=dev
LOG_LEVEL=info

# Sign-in (ADR-003). Generate your own secret: openssl rand -base64 48
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48
AUTH_URL=http://localhost:3000

# Local Keycloak from ~/sirius/local-infra (stands in for Entra ID).
OIDC_ISSUER=http://keycloak.sirius.test:8180/realms/sirius
OIDC_TENANT_ID=5a1f0c2e-7b3d-4e8a-9c21-5e7f0000c0de
OIDC_ALLOW_HTTP=true
OIDC_CLIENT_ID=peopleforge-web
OIDC_CLIENT_SECRET=local-peopleforge-web-secret-2026
OIDC_SCOPES=openid profile email

# PostgreSQL from local-infra. The app role has data access only; migrations use the owner.
DATABASE_URL=postgres://peopleforge_app:local-pf-app-2026@localhost:55432/peopleforge
DATABASE_OWNER_URL=postgres://peopleforge_owner:local-pf-owner-2026@localhost:55432/peopleforge

PEOPLEFORGE_API_URL=http://localhost:4000
