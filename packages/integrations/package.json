{
  "name": "@peopleforge/integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Adapters for external services: object storage (S3-compatible, filesystem for dev/test), ClamAV malware scanning, email (SMTP, .eml files for dev/test), file-type detection, circuit breaker.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@smithy/node-http-handler": "4.12.1",
    "file-type": "22.1.1",
    "nodemailer": "10.0.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sirius/config": "0.1.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
