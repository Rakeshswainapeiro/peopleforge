# Copy to packages/db/.env for local development. Never commit real values.
# Migrations and the dev seed run as the schema OWNER; the apps connect as the app role.
APP_ENV=dev
DATABASE_OWNER_URL=postgres://peopleforge_owner:local-pf-owner-2026@localhost:55432/peopleforge
DATABASE_APP_ROLE=peopleforge_app

# Salary encryption keys (ADR-008): id:base64(32 bytes), comma-separated; newest is active.
# Generate one: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=local-1:replace-with-32-random-bytes-in-base64
DATA_ENCRYPTION_ACTIVE_KEY=local-1
