{
  "name": "@peopleforge/db",
  "version": "0.1.0",
  "private": true,
  "description": "PeopleForge database: SQL migrations, Row-Level Security scope, typed Kysely access, field encryption, dev seed (ADR-002, ADR-008).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "node --env-file-if-exists=.env dist/cli/migrate.js core up",
    "migrate:rollback": "node --env-file-if-exists=.env dist/cli/migrate.js core down",
    "migrate:status": "node --env-file-if-exists=.env dist/cli/migrate.js core status",
    "seed": "node --env-file-if-exists=.env dist/cli/seed.js"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sirius/config": "0.1.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
