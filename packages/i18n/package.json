{
  "name": "@peopleforge/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "PeopleForge message catalogues: flattening, interpolation, English fallback and plural forms, shared by the web app and the worker.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sirius/shared-types": "0.1.0"
  },
  "devDependencies": {
    "@sirius/config": "0.1.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "files": [
    "dist"
  ]
}
